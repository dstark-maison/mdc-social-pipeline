# Copy to .env.local for local dev only — never commit real values.
# In production (GitHub Actions) these are injected from repo secrets.
# Local runs need an env loader (e.g. `python -m dotenv run -- python draft.py`
# with python-dotenv installed) since the scripts read os.environ directly.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_BLOG_HANDLE=blog
STOREFRONT_DOMAIN=www.maisondecocon.com

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Meta system-user token (secret META_SYSTEM_USER_TOKEN). Never printed or stored.
ACCESS_TOKEN=
IG_USER_ID=your-instagram-business-account-id

RESEND_API_KEY=
RESEND_FROM=MDC Instagram Pipeline <you@example.com>
RESEND_TO=you@example.com

# publish.py: the approval title (normally set by the workflow)
# TITLE=approve:some-article-handle:ig
# RESULT_FILE=result.md

BIO_LINK_PATH=/pages/latest-post

# Auto-set by GitHub Actions in production — set manually for local testing
GITHUB_REPOSITORY=dstark-maison/mdc-social-pipeline
GITHUB_REF_NAME=main

# Pinterest (secrets PINTEREST_APP_ID, PINTEREST_APP_SECRET, PINTEREST_REFRESH_TOKEN, PINTEREST_STATE_KEY)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REFRESH_TOKEN=
PINTEREST_STATE_KEY=
# PINTEREST_API_BASE=https://api-sandbox.pinterest.com   # Trial access sandbox, if production writes are refused
